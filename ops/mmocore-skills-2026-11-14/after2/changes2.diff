+
+# ---------------------------------------------------------------- POWER_MARK (Метка силы)
+# RQ fix 2026-11-14: replaces default:POWER_MARK. The built-in skill picks its
+# spot with a BLOCK-ONLY ray, so aiming at a mob put the mark on the ground
+# behind it and it never charged. Here the mark is put ON the enemy under the
+# crosshair: it stores <modifier.ratio>% of all damage that enemy takes during
+# <modifier.duration> s (health before - health after), then explodes: the
+# stored damage + stun (<modifier.stun> s) on enemies within 5 blocks of it.
+# Aiming at a block marks the nearest valid enemy within 2 blocks of that spot.
+rq_power_mark:
+  public: true
+  mechanics:
+    - 'set_double{variable=rq_pm_done;value=0}'
+    - 'ray_trace{range=50;size=0.35;offense=true;neutral=false;ignore_passable=true;hit_entity=rq_power_mark_ent;hit_block=rq_power_mark_blk}'
+rq_power_mark_blk:
+  mechanics:
+    - 'sound{sound=BLOCK_END_PORTAL_FRAME_FILL;volume=1;pitch=1.5}'
+    - 'script{name=rq_power_mark_pick;target={type=nearby_entities;radius=2;ignore_caster=false}}'
+# only the first valid enemy is marked (rq_pm_done guards the shared variables)
+rq_power_mark_pick:
+  conditions:
+    - 'can_target'
+    - 'boolean{formula="<rq_pm_done> < 1"}'
+  mechanics:
+    - 'script{name=rq_power_mark_ent}'
+rq_power_mark_ent:
+  mechanics:
+    - 'set_double{variable=rq_pm_done;value=1}'
+    - 'set_double{variable=rq_pm_h0;value="<target.health>"}'
+    - 'sound{sound=BLOCK_END_PORTAL_FRAME_FILL;volume=2;pitch=1}'
+    - 'script{name=rq_power_mark_tick;counter=rq_pm_i;iterations="<modifier.duration> * 5"}'
+    - 'delay{amount="<modifier.duration> * 20"}'
+    - 'script{name=rq_power_mark_boom;target_location={type=target;position=FEET}}'
+rq_power_mark_tick:
+  mechanics:
+    - 'delay{amount="(<rq_pm_i> - 1) * 4"}'
+    - 'particle{particle=WITCH;amount=6;x=0.6;y=0.05;z=0.6;target={type=target;position=FEET}}'
+    - 'sound{sound=BLOCK_NOTE_BLOCK_PLING;volume=0.4;pitch=1.6}'
+rq_power_mark_boom:
+  mechanics:
+    - 'set_double{variable=rq_pm_acc;value="max(0, (<rq_pm_h0>) - (<target.health>)) * (<modifier.ratio>) / 100"}'
+    - 'sound{sound=ENTITY_GENERIC_EXPLODE;volume=2;pitch=0.6}'
+    - 'particle{particle=EXPLOSION;amount=16;x=2;y=1;z=2;target={type=custom;relative=true;x=0;y=1;z=0}}'
+    - 'particle{particle=WITCH;amount=60;x=2.5;y=0.2;z=2.5;speed=0.3;target={type=custom;relative=true;x=0;y=0.3;z=0}}'
+    - 'script{name=rq_power_mark_hit;target={type=nearby_entities;radius=5;ignore_caster=false}}'
+rq_power_mark_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'potion{effect=SLOWNESS;level=10;ticks="<modifier.stun> * 20";particles=false}'
+    - 'script{name=rq_power_mark_dmg}'
+rq_power_mark_dmg:
+  conditions:
+    - 'boolean{formula="<rq_pm_acc> > 0.01"}'
+  mechanics:
+    - 'damage{amount="<rq_pm_acc>";knockback=false;ignore_immunity=true}'
+
+# ---------------------------------------------------------------- SNOWMAN_TURRET (Снеговик-турель)
+# RQ fix 2026-11-14: replaces default:SNOWMAN_TURRET. The built-in skill
+#  - put the turret on the block BEHIND the aimed enemy (block-only ray) and did
+#    not cast at all when aiming at the sky;
+#  - set <damage> on EVERY entity its vanilla snowballs hit: a snowball that
+#    missed the enemy flew on and hit the caster (measured: caster -9.5 HP) or
+#    allies, ignoring PvP / party rules.
+# Here the turret stands 2 blocks in front of the aimed enemy (or on the aimed
+# block) and, once per second, throws a MythicLib snowball projectile at one valid
+# enemy within <modifier.radius>; the projectile only collides with valid
+# enemies (can_target), so the caster / party members are never hit.
+# Lasts <modifier.duration> s (max 15 s, as built-in). The snowman is drawn
+# with particles (a real Snow Golem would need console commands).
+rq_snowman_turret:
+  public: true
+  mechanics:
+    - 'ray_trace{range=50;size=0.35;offense=true;neutral=false;ignore_passable=true;hit_entity=rq_turret_ent;hit_block=rq_turret_at}'
+rq_turret_ent:
+  mechanics:
+    - 'set_double{variable=rq_tu_h;value="max(0.001, sqrt(((<caster.location.x>) - (<target.location.x>))^2 + ((<caster.location.z>) - (<target.location.z>))^2))"}'
+    - 'set_double{variable=rq_tu_o;value="min(2, (<rq_tu_h>) * 0.5) / (<rq_tu_h>)"}'
+    - 'script{name=rq_turret_at;target_location={type=custom;relative=false;x="(<target.location.x>) + ((<caster.location.x>) - (<target.location.x>)) * (<rq_tu_o>)";y="<target.location.y>";z="(<target.location.z>) + ((<caster.location.z>) - (<target.location.z>)) * (<rq_tu_o>)"}}'
+rq_turret_at:
+  mechanics:
+    - 'sound{sound=BLOCK_SNOW_PLACE;volume=1.5;pitch=0.8}'
+    - 'sound{sound=ENTITY_SNOW_GOLEM_AMBIENT;volume=1;pitch=1}'
+    - 'script{name=rq_turret_fx;counter=rq_tu_j;iterations="min(<modifier.duration> * 20, 300) / 10"}'
+    - 'script{name=rq_turret_tick;counter=rq_tu_i;iterations="min(<modifier.duration> * 20, 300) / 20"}'
+rq_turret_fx:
+  mechanics:
+    - 'delay{amount="(<rq_tu_j> - 1) * 10"}'
+    - 'particle{particle=DUST;amount=14;x=0.22;y=0.22;z=0.22;color={red=245;green=250;blue=255};target={type=custom;relative=true;x=0;y=0.45;z=0}}'
+    - 'particle{particle=DUST;amount=10;x=0.16;y=0.16;z=0.16;color={red=245;green=250;blue=255};target={type=custom;relative=true;x=0;y=1.05;z=0}}'
+    - 'particle{particle=DUST;amount=3;x=0.05;y=0.05;z=0.05;color={red=230;green=120;blue=20};target={type=custom;relative=true;x=0;y=1.5;z=0}}'
+    - 'particle{particle=SNOWFLAKE;amount=3;x=0.4;y=0.6;z=0.4;target={type=custom;relative=true;x=0;y=0.8;z=0}}'
+rq_turret_tick:
+  mechanics:
+    - 'delay{amount="(<rq_tu_i> - 1) * 20 + 5"}'
+    - 'set_double{variable=rq_tu_shot;value=0}'
+    - 'script{name=rq_turret_aim;target={type=nearby_entities;radius="<modifier.radius>";ignore_caster=false}}'
+rq_turret_aim:
+  conditions:
+    - 'can_target'
+    - 'boolean{formula="<rq_tu_shot> < 1"}'
+  mechanics:
+    - 'set_double{variable=rq_tu_shot;value=1}'
+    - 'sound{sound=ENTITY_SNOWBALL_THROW;volume=1;pitch=1.3}'
+    - 'projectile{speed=26;life_span=20;size=0.3;offense=true;hits=1;stop_on_block=true;ignore_passable=true;source={type=custom;relative=true;x=0;y=1.3;z=0};target={type=target;position=BODY};tick=rq_turret_trail;hit_entity=rq_turret_hit;hit_block=rq_turret_trail}'
+rq_turret_trail:
+  mechanics:
+    - 'particle{particle=ITEM_SNOWBALL;amount=1}'
+rq_turret_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'particle{particle=ITEM_SNOWBALL;amount=8;x=0.2;y=0.2;z=0.2;target={type=target;position=BODY}}'
+    - 'damage{amount="<modifier.damage>";knockback=false;damage_type="SKILL,PROJECTILE"}'
