+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="0";y=0.1;z="0"};target={type=custom;relative=true;source=true;x="(<rq_bl_dx>)";y=0.1;z="(<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28)";y=0.1;z="(<rq_bl_dx>) * (0.28)"};target={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28) + (<rq_bl_dx>)";y=0.1;z="(<rq_bl_dx>) * (0.28) + (<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (0.28)";y=0.9;z="(<rq_bl_dx>) * (-0.28)"};target={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (0.28) + (<rq_bl_dx>)";y=0.9;z="(<rq_bl_dx>) * (-0.28) + (<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="0";y=0.9;z="0"};target={type=custom;relative=true;source=true;x="(<rq_bl_dx>)";y=0.9;z="(<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28)";y=0.9;z="(<rq_bl_dx>) * (0.28)"};target={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28) + (<rq_bl_dx>)";y=0.9;z="(<rq_bl_dx>) * (0.28) + (<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (0.28)";y=1.8;z="(<rq_bl_dx>) * (-0.28)"};target={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (0.28) + (<rq_bl_dx>)";y=1.8;z="(<rq_bl_dx>) * (-0.28) + (<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="0";y=1.8;z="0"};target={type=custom;relative=true;source=true;x="(<rq_bl_dx>)";y=1.8;z="(<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'ray_trace{mode=BLOCKS;range="<rq_bl_r> + 0.5";ignore_passable=true;source={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28)";y=1.8;z="(<rq_bl_dx>) * (0.28)"};target={type=custom;relative=true;source=true;x="(<rq_bl_dz>) * (-0.28) + (<rq_bl_dx>)";y=1.8;z="(<rq_bl_dx>) * (0.28) + (<rq_bl_dz>)"};hit_block=rq_blink_wall}'
+    - 'set_double{variable=rq_bl_t;value="max(0, min(<rq_bl_r>, (<rq_bl_d>) - 0.5))"}'
