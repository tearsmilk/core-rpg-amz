+    - 'particle{particle=DUST;amount=70;x=2;y=0.3;z=2;color={red=90;green=200;blue=40};target={type=custom;relative=true;x=0;y=0.3;z=0}}'
+    - 'particle{particle=ITEM_SLIME;amount=30;x=2;y=0.3;z=2;target={type=custom;relative=true;x=0;y=0.3;z=0}}'
