+rq_contamination_tick:
+  mechanics:
+    - 'delay{amount="(<rq_ct_i> - 1) * 20"}'
+    - 'particle{particle=DUST;amount=60;x=2.5;y=0.2;z=2.5;color={red=130;green=20;blue=170};target={type=custom;relative=true;x=0;y=0.3;z=0}}'
+    - 'particle{particle=WITCH;amount=15;x=2;y=0.3;z=2;target={type=custom;relative=true;x=0;y=0.3;z=0}}'
