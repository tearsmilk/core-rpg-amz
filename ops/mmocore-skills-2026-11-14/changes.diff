--- orig/plugins/MythicLib/script/royalquest_skills.yml	2026-11-14 19:53:16.203180601 +0000
+++ new/plugins/MythicLib/script/royalquest_skills.yml	2026-11-14 20:18:55.700720925 +0000
@@ -26,3 +26,303 @@
       interaction_type: OFFENSE_SKILL
   mechanics:
     - 'damage{amount="<modifier.damage>";knockback=false}'
+
+##############################################################################
+# RoyalQuest skill fixes (2026-11-14)
+#
+# Why these exist: MythicLib's built-in "location" skills (ICE_SPIKES,
+# LIGHTNING_BEAM, FREEZE, ARCANE_HAIL, ...) pick their target point with a
+# BLOCK-ONLY ray trace (LocationSkillResult -> Player#rayTraceBlocks), so when
+# you aim at a player/mob the spell lands on the block BEHIND it.
+# The scripts below use 'ray_trace' (blocks AND entities): if the crosshair is
+# on a valid enemy the spell lands at that enemy's feet, otherwise on the block.
+##############################################################################
+
+# ---------------------------------------------------------------- ICE_SPIKES
+rq_ice_spikes:
+  public: true
+  mechanics:
+    - 'ray_trace{range=30;size=0.35;offense=true;ignore_passable=true;hit_entity=rq_ice_spikes_ent;hit_block=rq_ice_spikes_at}'
+rq_ice_spikes_ent:
+  mechanics:
+    - 'script{name=rq_ice_spikes_at;target_location={type=target;position=FEET}}'
+rq_ice_spikes_at:
+  mechanics:
+    - 'sound{sound=BLOCK_GLASS_BREAK;volume=1.5;pitch=0.6}'
+    - 'sound{sound=ENTITY_PLAYER_HURT_FREEZE;volume=1;pitch=0.8}'
+    - 'script{name=rq_ice_spikes_fx;counter=rq_is_i;iterations=10}'
+    - 'script{name=rq_ice_spikes_hit;target={type=nearby_entities;radius=3}}'
+rq_ice_spikes_fx:
+  mechanics:
+    - 'particle{particle=SNOWFLAKE;amount=10;x=0.1;y=0.7;z=0.1;target={type=custom;relative=true;x="(random() * 2 - 1) * 2.5";y=0.8;z="(random() * 2 - 1) * 2.5"}}'
+    - 'particle{particle=ITEM_SNOWBALL;amount=6;x=0.15;y=0.5;z=0.15;target={type=custom;relative=true;x="(random() * 2 - 1) * 2.5";y=0.6;z="(random() * 2 - 1) * 2.5"}}'
+rq_ice_spikes_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'damage{amount="<modifier.damage>";knockback=false}'
+    - 'potion{effect=SLOWNESS;level=1;ticks="<modifier.slow> * 20"}'
+
+# ---------------------------------------------------------------- LIGHTNING_BEAM
+rq_lightning_beam:
+  public: true
+  mechanics:
+    - 'ray_trace{range=30;size=0.35;offense=true;ignore_passable=true;hit_entity=rq_lightning_beam_ent;hit_block=rq_lightning_beam_at}'
+rq_lightning_beam_ent:
+  mechanics:
+    - 'script{name=rq_lightning_beam_at;target_location={type=target;position=FEET}}'
+rq_lightning_beam_at:
+  mechanics:
+    - 'sound{sound=ENTITY_LIGHTNING_BOLT_THUNDER;volume=0.8;pitch=1.6}'
+    - 'sound{sound=ENTITY_LIGHTNING_BOLT_IMPACT;volume=1;pitch=1}'
+    - 'particle{particle=ELECTRIC_SPARK;amount=80;x=0.12;y=5;z=0.12;target={type=custom;relative=true;x=0;y=5;z=0}}'
+    - 'particle{particle=END_ROD;amount=30;x=0.08;y=5;z=0.08;target={type=custom;relative=true;x=0;y=5;z=0}}'
+    - 'particle{particle=FIREWORK;amount=40;speed=0.2;target={type=custom;relative=true;x=0;y=0.3;z=0}}'
+    - 'script{name=rq_lightning_beam_hit;target={type=nearby_entities;radius="<modifier.radius>"}}'
+rq_lightning_beam_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'damage{amount="<modifier.damage>"}'
+
+# ---------------------------------------------------------------- FREEZE
+rq_freeze:
+  public: true
+  mechanics:
+    - 'ray_trace{range=30;size=0.35;offense=true;ignore_passable=true;hit_entity=rq_freeze_ent;hit_block=rq_freeze_at}'
+rq_freeze_ent:
+  mechanics:
+    - 'script{name=rq_freeze_at;target_location={type=target;position=FEET}}'
+rq_freeze_at:
+  mechanics:
+    - 'sound{sound=BLOCK_GLASS_BREAK;volume=1;pitch=1.6}'
+    - 'sound{sound=ENTITY_PLAYER_HURT_FREEZE;volume=1;pitch=1.2}'
+    - 'particle{particle=SNOWFLAKE;amount=70;x=2;y=0.4;z=2;speed=0.02;target={type=custom;relative=true;x=0;y=0.5;z=0}}'
+    - 'particle{particle=ITEM_SNOWBALL;amount=30;x=2;y=0.3;z=2;target={type=custom;relative=true;x=0;y=0.4;z=0}}'
+    - 'script{name=rq_freeze_hit;target={type=nearby_entities;radius="<modifier.radius>"}}'
+rq_freeze_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'potion{effect=SLOWNESS;level="<modifier.amplifier>";ticks="<modifier.duration> * 20"}'
+    - 'particle{particle=SNOWFLAKE;amount=12;x=0.3;y=0.5;z=0.3;target={type=target}}'
+
+# ---------------------------------------------------------------- ARCANE_HAIL
+rq_arcane_hail:
+  public: true
+  mechanics:
+    - 'ray_trace{range=30;size=0.35;offense=true;ignore_passable=true;hit_entity=rq_arcane_hail_ent;hit_block=rq_arcane_hail_at}'
+rq_arcane_hail_ent:
+  mechanics:
+    - 'script{name=rq_arcane_hail_at;target_location={type=target;position=FEET}}'
+rq_arcane_hail_at:
+  mechanics:
+    - 'sound{sound=ENTITY_EVOKER_CAST_SPELL;volume=1;pitch=1.4}'
+    - 'script{name=rq_arcane_hail_tick;counter=rq_ah_i;iterations="<modifier.duration> * 10"}'
+rq_arcane_hail_tick:
+  mechanics:
+    - 'delay{amount="(<rq_ah_i> - 1) * 2"}'
+    - 'script{name=rq_arcane_hail_strike;target_location={type=custom;relative=true;x="(random() * 2 - 1) * <modifier.radius>";y=0;z="(random() * 2 - 1) * <modifier.radius>"}}'
+rq_arcane_hail_strike:
+  mechanics:
+    - 'particle{particle=END_ROD;amount=4;x=0.03;y=1.2;z=0.03;target={type=custom;relative=true;x=0;y=1.2;z=0}}'
+    - 'particle{particle=WITCH;amount=12;x=0.1;y=0.1;z=0.1;speed=0.1}'
+    - 'particle{particle=SMOKE;amount=6;speed=0.05}'
+    - 'sound{sound=ENTITY_ENDERMAN_HURT;volume=0.5;pitch=2}'
+    - 'script{name=rq_arcane_hail_hit;target={type=nearby_entities;radius=2}}'
+rq_arcane_hail_hit:
+  conditions:
+    - 'can_target'
+  mechanics:
+    - 'damage{amount="<modifier.damage>";knockback=false}'
+
+# ---------------------------------------------------------------- BLACK_HOLE
+rq_black_hole:
+  public: true
+  mechanics:
+    - 'ray_trace{range=30;size=0.35;offense=true;ignore_passable=true;hit_entity=rq_black_hole_ent;hit_block=rq_black_hole_at}'
+rq_black_hole_ent:
+  mechanics:
+    - 'script{name=rq_black_hole_at;target_location={type=target;position=FEET}}'
+rq_black_hole_at:
+  mechanics:
+    - 'sound{sound=BLOCK_BEACON_ACTIVATE;volume=1;pitch=0.5}'
+    - 'sound{sound=ENTITY_ENDERMAN_TELEPORT;volume=1;pitch=0.5}'
+    - 'script{name=rq_black_hole_tick;counter=rq_bh_i;iterations="<modifier.duration> * 10"}'
+rq_black_hole_tick:
+  mechanics:
+    - 'delay{amount="(<rq_bh_i> - 1) * 2"}'
+    - 'particle{particle=PORTAL;amount=25;x=1;y=0.6;z=1;speed=0.6;target={type=custom;relative=true;x=0;y=0.8;z=0}}'
+    - 'particle{particle=SQUID_INK;amount=3;x=0.15;y=0.15;z=0.15;target={type=custom;relative=true;x=0;y=0.8;z=0}}'
+    - 'copy_vector{variable=rq_bh_c;value=target_location}'
+    - 'script{name=rq_black_hole_pull;target={type=nearby_entities;radius="<modifier.radius>"}}'
+rq_black_hole_pull:
+  conditions:
+    - 'can_target'
+  mechanics:
