         if (!NAME.matcher(name).matches()) throw new IllegalArgumentException("имя карты: a-z 0-9 _ - (до 32 символов)");
         Path d = dir.resolve(name);
         if (Files.exists(d)) throw new IllegalArgumentException("карта «" + name + "» уже есть");
