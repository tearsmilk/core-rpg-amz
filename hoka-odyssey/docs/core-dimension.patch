+            try { dimension = Key.key(dimension.trim()).asString(); }                // the_nether → minecraft:the_nether
+            catch (InvalidKeyException e) { throw new IllegalArgumentException("тип мира: ключ вида hoka:space"); }
+        }
+        if (dimension != null && !dimensionKeys().contains(dimension))
+            throw new IllegalArgumentException("типа мира «" + dimension + "» нет. Есть: " + String.join(", ", dimensionKeys()));
         try { Files.createDirectories(d); } catch (IOException e) { throw new IllegalStateException("не создать " + d + ": " + e.getMessage()); }
         ModuleConfig meta = new ModuleConfig(d.resolve("map.yml"));
         meta.set("generator", gen.key());
+        if (dimension != null) meta.set("dimension", dimension);
         meta.set("created", new java.util.Date().toString());
