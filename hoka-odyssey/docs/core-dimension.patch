+    /**
+     * Тип мира по ключу из map.yml. Пусто — overworld; неизвестный ключ (модуль с типом не установлен,
+     * опечатка) — предупреждение и overworld, чтобы карта всё равно открылась.
+     * Важно: Anvil не хранит тип мира — секции чанков вне minY..maxY нового типа при загрузке
+     * пропускаются и при следующем сохранении теряются. Менять dimension у карты с постройками
+     * можно только на тип с тем же (или более широким) диапазоном высот.
+     */
+    static RegistryKey<DimensionType> dimension(String map, String id) {
+        if (id == null || id.isBlank()) return DimensionType.OVERWORLD;
+        RegistryKey<DimensionType> key = null;
+        try { key = MinecraftServer.getDimensionTypeRegistry().getKey(Key.key(id.trim())); }
+        catch (InvalidKeyException e) { /* ниже — как неизвестный */ }
+        if (key == null) {
+            LOG.warn("карта «{}»: тип мира «{}» не найден в реестре — загружаю как minecraft:overworld", map, id);
+            return DimensionType.OVERWORLD;
+        }
+        return key;
+    }
+
+    /** Ключи всех зарегистрированных типов мира (для подсказок /homap create). */
+    public static List<String> dimensionKeys() {
+        List<String> out = new ArrayList<>();
+        for (RegistryKey<DimensionType> k : MinecraftServer.getDimensionTypeRegistry().keys()) out.add(k.key().asString());
+        Collections.sort(out);
+        return out;
+    }
+
+    public static boolean isOverworld(RegistryKey<DimensionType> k) { return k.key().equals(DimensionType.OVERWORLD.key()); }
+
