        path: assets/skill_casting_bar/slot5.png
      offset:
        x: 116
        y: -16
    input6:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_6%;v=noskill} false hide
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
