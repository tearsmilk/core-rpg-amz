        path: assets/skill_casting_bar/slot6.png
      offset:
        x: 143
        y: -16

    cooldown-skill1text:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_1%;v=0;o=>} true hide
      text: "%math_0:_{utils_shortcut_noskillcd_check:1}+1%" ###If you prefer the cooldown to display the last second as 0 instead of 1, replace the text with this: "%mmocore_cooldown_bound_1%"
      font: "default"
      align: center
      offset:
        x: 10
        y: -6
    cooldown-skill_1_icon:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_1%;v=0;o=>} true hide
      texture:
        path: assets/skill_casting_bar/icon_cooldown.png
      offset:
        x: 2
        y: -2
    oom-skill_1_icon:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{1=%utils_shortcut_mana_check:1%;o=>;v=%mmocore_mana%} true hide       
      texture:
        path: assets/skill_casting_bar/icon_oom.png
      offset:
        x: 2
        y: -2
