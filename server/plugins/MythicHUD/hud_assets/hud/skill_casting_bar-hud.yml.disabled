skill_casting_bar:
  layers:
  #####If YOU ARE NOT USING THE HOTBAR SKILL CASTING METHOD (using 1,2,3,4,5,6,7,8 hotkeys), YOU CAN DELETE ALL THE LAYERS BELOW NAMED "INPUT1", "INPUT2", "INPUT3", "INPUT4", "INPUT5", AND "INPUT6"
    input1:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_1%;v=noskill} false hide ###Hide the slot if no skill is bound to this slot. If you want the empty slot  to stay visible, remove this line.
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
        - placeholder{ph=%player_held_item_slot%;v=0} true texture assets/skill_casting_bar/slot2.png
      texture:
        path: assets/skill_casting_bar/slot1.png
      offset:
        x: 8
        y: -16
    input2:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_2%;v=noskill} false hide
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
        - placeholder{ph=%player_held_item_slot%;v=0} true texture assets/skill_casting_bar/slot3.png
        - placeholder{ph=%player_held_item_slot%;v=1} true texture assets/skill_casting_bar/slot3.png
      texture:
        path: assets/skill_casting_bar/slot2.png
      offset:
        x: 35
        y: -16
    input3:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_3%;v=noskill} false hide
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
        - placeholder{ph=%player_held_item_slot%;v=0} true texture assets/skill_casting_bar/slot4.png
        - placeholder{ph=%player_held_item_slot%;v=1} true texture assets/skill_casting_bar/slot4.png
        - placeholder{ph=%player_held_item_slot%;v=2} true texture assets/skill_casting_bar/slot4.png
      texture:
        path: assets/skill_casting_bar/slot3.png
      offset:
        x: 62
        y: -16
    input4:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_4%;v=noskill} false hide
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
        - placeholder{ph=%player_held_item_slot%;v=0} true texture assets/skill_casting_bar/slot5.png
        - placeholder{ph=%player_held_item_slot%;v=1} true texture assets/skill_casting_bar/slot5.png
        - placeholder{ph=%player_held_item_slot%;v=2} true texture assets/skill_casting_bar/slot5.png
        - placeholder{ph=%player_held_item_slot%;v=3} true texture assets/skill_casting_bar/slot5.png
      texture:
        path: assets/skill_casting_bar/slot4.png
      offset:
        x: 89
        y: -16
    input5:
      conditions:
        - placeholder{ph=%mmocore_class_id%;v=HUMAN} false hide ### Mia: bar only for players with an RQ/MMOCore skill class
        - placeholder{ph=%mmocore_cooldown_bound_5%;v=noskill} false hide
        - placeholder{ph=%mmocore_is_casting%;v=true} true hide ###Hide the slot if the player is not in skill casting mode. If you want the bar visible at all time, remove this line.
        - placeholder{ph=%player_held_item_slot%;v=0} true texture assets/skill_casting_bar/slot6.png
        - placeholder{ph=%player_held_item_slot%;v=1} true texture assets/skill_casting_bar/slot6.png
